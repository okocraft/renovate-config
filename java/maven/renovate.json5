{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>okocraft/renovate-config//base.renovate.json5'
  ],
  packageRules: [
    {
      matchManagers: [
        'maven',
        'maven-wrapper'
      ],
      "allowedVersions": "!/.*-SNAPSHOT$/"
    },
    {
      groupName: 'all non-major dependencies for Maven',
      groupSlug: 'maven-all-minor-patch',
      matchManagers: [
        'maven',
        'maven-wrapper'
      ],
      matchUpdateTypes: [
        'minor',
        'patch'
      ],
      matchPackageNames: [
        '*'
      ],
    }
  ]
}
