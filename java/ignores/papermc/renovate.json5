{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      matchManagers: [
        'maven',
        'gradle'
      ],
      "matchPackageNames": [
        '/com\\.destroystokyo\\.paper:paper-api/',
        '/io\\.github\\.waterfallmc:waterfall-api/'
      ],
      "enabled": false
    },
    {
      matchManagers: [
        'maven',
        'gradle'
      ],
      "matchPackageNames": [
        '/io\\.papermc\\.paper:paper-api/',
        '/dev\\.folia:folia-api/',
        '/com\\.velocitypowered:velocity-api/'
      ],
      registryUrls: [
        'https://repo.papermc.io/repository/maven-public/'
      ],
      "enabled": true
    },
    {
      matchManagers: [
        'maven',
        'gradle'
      ],
      "matchPackageNames": [
        '/io\\.papermc\\.paper:paper-api/',
        '/dev\\.folia:folia-api/'
      ],
      minimumReleaseAge: '3 days',
      ignoreUnstable: false,
      allowedVersions: '!/-alpha(?:\\.|$)/'
    },
    {
      matchManagers: [
        'maven',
        'gradle'
      ],
      "matchPackageNames": [
        '/com\\.mojang:brigadier/'
      ],
      registryUrls: [
        'https://libraries.minecraft.net/'
      ],
      "enabled": true
    }
  ]
}
