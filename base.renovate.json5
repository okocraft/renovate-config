{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':configMigration',
    'schedule:daily',
    ':updateNotScheduled'
  ],
  minimumReleaseAge: '7 days',
  reviewers: [
    'team:maintainer'
  ],
  packageRules: [
    {
      description: 'Automerge non-major updates after CI passes',
      matchUpdateTypes: [
        'minor',
        'patch'
      ],
      automerge: true,
      platformAutomerge: false
    }
  ]
}
