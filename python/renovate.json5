{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>okocraft/renovate-config//base.renovate.json5'
  ],
  packageRules: [
    {
      groupName: 'all non-major dependencies for python',
      groupSlug: 'python-all-minor-patch',
      matchCategories: [
        'python'
      ],
      matchUpdateTypes: [
        'minor',
        'patch'
      ]
    }
  ]
}
