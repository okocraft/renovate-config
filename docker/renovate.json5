{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>okocraft/renovate-config//base.renovate.json5',
    'docker:pinDigests'
  ],
  packageRules: [
    {
      matchDatasources: [
        'docker',
      ],
      minimumReleaseAge: null,
    },
    {
      groupName: 'all non-major dependencies for Docker',
      groupSlug: 'docker-all-minor-patch',
      matchManagers: [
        'dockerfile',
        'docker-compose',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        '*',
      ],
    }
  ]
}
